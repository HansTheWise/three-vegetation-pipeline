{
  "name": "three-vegetation-pipeline",
  "version": "0.2.0",
  "description": "A modular, data-driven vegetation pipeline for Three.js.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "dist",
    "tooling/veg-compile.mjs"
  ],
  "bin": {
    "veg-compile": "tooling/veg-compile.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/package-entrypoints/PublicApi.d.ts",
      "import": "./dist/package-entrypoints/PublicApi.js",
      "default": "./dist/package-entrypoints/PublicApi.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./webgl": {
      "types": "./dist/package-entrypoints/WebGLApi.d.ts",
      "import": "./dist/package-entrypoints/WebGLApi.js",
      "default": "./dist/package-entrypoints/WebGLApi.js"
    },
    "./profiles/grass": {
      "types": "./dist/layer-profiles/grass/index.d.ts",
      "import": "./dist/layer-profiles/grass/index.js",
      "default": "./dist/layer-profiles/grass/index.js"
    },
    "./debug": {
      "types": "./dist/package-entrypoints/DebugApi.d.ts",
      "import": "./dist/package-entrypoints/DebugApi.js",
      "default": "./dist/package-entrypoints/DebugApi.js"
    },
    "./pre-runtime-compiler-core": {
      "types": "./dist/pre-runtime-compiler-core/index.d.ts",
      "import": "./dist/pre-runtime-compiler-core/index.js",
      "default": "./dist/pre-runtime-compiler-core/index.js"
    },
    "./node-pre-runtime-compiler-integration": {
      "types": "./dist/node-pre-runtime-compiler-integration/index.d.ts",
      "import": "./dist/node-pre-runtime-compiler-integration/index.js",
      "default": "./dist/node-pre-runtime-compiler-integration/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "benchmark": "vitest bench --run benchmarks",
    "benchmark:webgl": "vite --host 127.0.0.1 --open /benchmarks/webgl-render-tile-submission.html",
    "debug:webgl": "vite --host 127.0.0.1 --open /examples/webgl-debug-chunks.html?near",
    "example:webgl": "vite --host 127.0.0.1 --open /examples/webgl-runtime.html",
    "veg:compile": "tsc -p tsconfig.build.json && node --experimental-strip-types tooling/veg-compile.mjs",
    "test": "vitest run",
    "test:package": "node tooling/package-smoke-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:package"
  },
  "peerDependencies": {
    "three": ">=0.184.0 <0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "0.185.3",
    "three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
